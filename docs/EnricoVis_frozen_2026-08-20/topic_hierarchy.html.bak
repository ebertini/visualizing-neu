const PARENT_COLORS=["#4E79A7","#F28E2B","#59A14F","#B07AA1","#76B7B2","#EDC948","#9C755F","#D37295"];
const FUND={"NSF":"#0072B2","NIH":"#E69F00","NIH-SUB":"#56B4E9","Navy":"#009E73","NASA":"#9467BD",
  "Army":"#E7298A","DOE":"#66A61E","AFRO":"#A6761D","Other":"#B0B4BB"};
const pColor=pid=>PARENT_COLORS[pid%PARENT_COLORS.length];
const PNAME={},LNAME={},LPAR={};
HIER.parents.forEach(p=>PNAME[p.id]=p.name);
HIER.leaves.forEach(l=>{LNAME[l.id]=l.name;LPAR[l.id]=l.parent;});

// leaf colors = lightness variants of the parent hue
const leafColor={};
HIER.parents.forEach(p=>{
  const kids=HIER.leaves.filter(l=>l.parent===p.id).sort((a,b)=>a.id-b.id);
  const base=d3.hsl(pColor(p.id));
  const light=d3.hsl(base); light.l=Math.min(0.82,base.l+0.16);
  const dark=d3.hsl(base); dark.l=Math.max(0.30,base.l-0.12);
  const interp=d3.interpolateLab(light+"",dark+"");
  kids.forEach((l,i)=> leafColor[l.id]= kids.length>1?interp(i/(kids.length-1)):base+"");
});
function darken(c,f=0.7){const h=d3.hsl(c);h.l*=f;return h+"";}

const svg=d3.select("#svg"), scene=svg.append("g");
const gIslands=scene.append("g"), gLabels=scene.append("g");
const tip=document.getElementById("tip");

const rmax=d3.max(DATA,d=>d.amount)||1;
const rAmt=d3.scaleSqrt().domain([0,rmax]).range([2,13]);
const PAD_P=16, PAD_L=5, GAP_PARENT=32;
let sizeBy=false, colorFunding=false, curK=1;
let hoverP=null,hoverL=null,pinP=null,pinL=null,zoomMoved=false;
const actP=()=> pinL!=null?LPAR[pinL] : pinP!=null?pinP : hoverL!=null?LPAR[hoverL] : hoverP;
const actL=()=> pinL!=null?pinL : hoverL;

const fmtAmt=v=>v>=1e6?"$"+(v/1e6).toFixed(v>=1e7?0:1)+"M":v>=1e3?"$"+Math.round(v/1e3)+"K":"$"+Math.round(v);
const esc=s=>(s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

const hullLine=d3.line().curve(d3.curveCatmullRomClosed).x(d=>d[0]).y(d=>d[1]);
function hullPath(circs,pad){
  const pts=[];
  for(const c of circs) for(let a=0;a<8;a++){
    const t=a/8*2*Math.PI; pts.push([c[0]+(c[2]+pad)*Math.cos(t), c[1]+(c[2]+pad)*Math.sin(t)]);
  }
  const h=d3.polygonHull(pts); return h?hullLine(h):null;
}
const radiusOf=d=> sizeBy?rAmt(d.amount):3.0;

let MODEL=null;
function layout(){
  const leaves=HIER.leaves.map(l=>({...l,grants:[]}));
  const leafById={}; leaves.forEach(l=>leafById[l.id]=l);
  const parents=HIER.parents.map(p=>({...p,leaves:[]}));
  const parById={}; parents.forEach(p=>parById[p.id]=p);
  DATA.forEach(d=>{ if(leafById[d.leaf]) leafById[d.leaf].grants.push(d); });
  leaves.forEach(l=> parById[l.parent] && parById[l.parent].leaves.push(l));

  // A: pack grants within each leaf
  leaves.forEach(l=>{
    const circ=l.grants.map(d=>({r:radiusOf(d),d}));
    d3.packSiblings(circ);
    const enc=d3.packEnclose(circ)||{x:0,y:0,r:3};
    l.RL=enc.r;
    l.local=circ.map(c=>({d:c.d,r:c.r,lx:c.x-enc.x,ly:c.y-enc.y}));
    l.cx=d3.mean(l.grants,d=>d.x)||0; l.cy=d3.mean(l.grants,d=>d.y)||0;
  });
  // B: place leaves within each parent
  parents.forEach(p=>{
    const gs=p.leaves.flatMap(l=>l.grants);
    p.cx=d3.mean(gs,d=>d.x)||0; p.cy=d3.mean(gs,d=>d.y)||0;
    const ln=p.leaves.map(l=>({l,r:l.RL,x:(l.cx-p.cx)*3,y:(l.cy-p.cy)*3}));
    d3.forceSimulation(ln)
      .force("x",d3.forceX(n=>(n.l.cx-p.cx)*3).strength(0.12))
      .force("y",d3.forceY(n=>(n.l.cy-p.cy)*3).strength(0.12))
      .force("collide",d3.forceCollide(n=>n.r+3).strength(1).iterations(6)).stop().tick(240);
    const enc=d3.packEnclose(ln.map(n=>({x:n.x,y:n.y,r:n.r})))||{x:0,y:0,r:10};
    p.RP=enc.r;
    ln.forEach(n=>{ n.l.px=n.x-enc.x; n.l.py=n.y-enc.y; });
  });
  // C: place parents in the plane by embedding centroid
  const exX=d3.extent(parents,p=>p.cx), exY=d3.extent(parents,p=>p.cy);
  const PW=1400,PH=950;
  const nx=v=>exX[1]===exX[0]?0.5:(v-exX[0])/(exX[1]-exX[0]);
  const ny=v=>exY[1]===exY[0]?0.5:(v-exY[0])/(exY[1]-exY[0]);
  parents.forEach(p=>{p.x=nx(p.cx)*PW;p.y=ny(p.cy)*PH;});
  d3.forceSimulation(parents)
    .force("x",d3.forceX(p=>nx(p.cx)*PW).strength(0.35))
    .force("y",d3.forceY(p=>ny(p.cy)*PH).strength(0.35))
    .force("collide",d3.forceCollide(p=>p.RP+GAP_PARENT).strength(1).iterations(6)).stop().tick(340);

  // compose RELATIVE positions (to the parent centre) so an island can be
  // dragged just by translating its group. Hulls + labels are relative too.
  parents.forEach(p=>{
    const pcirc=[];
    p.leaves.forEach(l=>{
      l.pts=l.local.map(c=>{
        const rx=l.px+c.lx, ry=l.py+c.ly;
        pcirc.push([rx,ry,c.r]);
        return {d:c.d,rx,ry,r:c.r,leaf:l.id,parent:p.id};
      });
      l.hull=hullPath(l.pts.map(n=>[n.rx,n.ry,n.r]),PAD_L);
      // inner label sits at the leaf centroid — deep inside the island, so it
      // can never reach the parent label that floats above the island.
      l.label={x:d3.mean(l.pts,n=>n.rx), y:d3.mean(l.pts,n=>n.ry),
               w:Math.max(26,l.name.length*5.0)};
    });
    decollide(p.leaves.map(l=>l.label));        // nudge sibling labels apart
    p.hull=hullPath(pcirc,PAD_P);
    p.topRel=d3.min(pcirc,q=>q[1]-q[2]);
    p.label={x:0, y:p.topRel-16};               // parent label above the island
  });
  MODEL={parents,leaves};
}

// resolve overlapping inner labels within one island by vertical nudging
function decollide(labels){
  const LH=12;
  labels.sort((a,b)=>a.y-b.y);
  for(let it=0;it<12;it++){
    let moved=false;
    for(let i=1;i<labels.length;i++){
      const a=labels[i-1], b=labels[i];
      if(Math.abs(a.x-b.x) < (a.w+b.w)/2 && (b.y-a.y) < LH){
        const push=(LH-(b.y-a.y))/2+0.3;
        a.y-=push; b.y+=push; moved=true;
      }
    }
    if(!moved) break;
  }
}

function fillOf(n){ return colorFunding?(FUND[n.d.agency]||"#B0B4BB"):leafColor[n.leaf]; }

function render(animate){
  const par=gIslands.selectAll("g.parent").data(MODEL.parents,p=>p.id)
    .join(en=>{const g=en.append("g").attr("class","parent");
      g.append("path").attr("class","phull"); return g;});
  par.attr("transform",p=>`translate(${p.x},${p.y})`).call(drag);
  par.select("path.phull").attr("d",p=>p.hull)
    .attr("fill",p=>pColor(p.id)).attr("stroke",p=>darken(pColor(p.id),0.75));

  const leaf=par.selectAll("g.leaf").data(p=>p.leaves,l=>l.id)
    .join(en=>{const g=en.append("g").attr("class","leaf");
      g.append("path").attr("class","lhull");
      g.append("g").attr("class","nodes");
      g.append("text").attr("class","llabel").attr("text-anchor","middle"); return g;});
  leaf.select("path.lhull").attr("d",l=>l.hull).attr("stroke",l=>darken(leafColor[l.id],0.75));
  leaf.select("text.llabel").attr("x",l=>l.label.x).attr("y",l=>l.label.y)
    .attr("fill",l=>darken(leafColor[l.id],0.45)).text(l=>l.name);

  const cir=leaf.select("g.nodes").selectAll("circle.node").data(l=>l.pts,n=>n.d.id)
    .join("circle").attr("class","node").attr("fill",n=>fillOf(n))
    .on("mousemove",showTip).on("mouseleave",hideTip);
  (animate?cir.transition().duration(450):cir).attr("cx",n=>n.rx).attr("cy",n=>n.ry).attr("r",n=>n.r);

  // parent label last + raised so it stays above the island's own contents
  par.selectAll("text.plabel").data(p=>[p])
    .join(en=>en.append("text").attr("class","plabel").attr("text-anchor","middle"))
    .attr("x",p=>p.label.x).attr("y",p=>p.label.y)
    .attr("fill",p=>darken(pColor(p.id),0.55)).text(p=>p.name);
  par.select("text.plabel").raise();
  applyFocus();
}
function recolor(){ gIslands.selectAll("circle.node").attr("fill",n=>fillOf(n)); }

/* drag whole islands to rearrange (screen delta / zoom scale = scene delta) */
const drag=d3.drag()
  .on("start",function(event){
    if(event.sourceEvent) event.sourceEvent.stopPropagation();  // don't pan
    const [mx,my]=d3.pointer(event.sourceEvent, svg.node());
    const p=d3.select(this).datum();
    this.__s={mx,my,px:p.x,py:p.y};
    d3.select(this).raise().classed("grabbing",true);
  })
  .on("drag",function(event){
    const p=d3.select(this).datum();
    const [mx,my]=d3.pointer(event.sourceEvent, svg.node());
    p.x=this.__s.px+(mx-this.__s.mx)/curK;
    p.y=this.__s.py+(my-this.__s.my)/curK;
    d3.select(this).attr("transform",`translate(${p.x},${p.y})`);
  })
  .on("end",function(){ d3.select(this).classed("grabbing",false); });

function applyFocus(){
  const ap=actP(), al=actL();
  gIslands.selectAll("g.parent").classed("faded",p=>ap!=null&&p.id!==ap);
  gIslands.selectAll("g.leaf").classed("faded",l=>al!=null&&l.id!==al);
  document.querySelectorAll(".prow").forEach(r=>r.classList.toggle("pinned",pinL==null&&pinP!=null&&+r.dataset.p===pinP));
  document.querySelectorAll(".lrow").forEach(r=>r.classList.toggle("pinned",pinL!=null&&+r.dataset.l===pinL));
}

function showTip(event,n){
  const d=n.d;
  tip.innerHTML=`<div class="t">${esc(d.title)}</div>`+
    `<div class="meta"><span class="dot" style="background:${FUND[d.agency]||'#B0B4BB'}"></span>`+
    `${esc(d.agencyLabel)}${d.year?` · ${d.year}`:""} · <span class="amt">${fmtAmt(d.amount)}</span>`+
    `${d.titleOnly?` · <span style="color:#9aa0a6">title only</span>`:""}</div>`+
    `<div class="path">${esc(PNAME[n.parent]||"")} &#9656; ${esc(LNAME[n.leaf]||"")}</div>`;
  tip.classList.add("show");
  const st=document.getElementById("stage").getBoundingClientRect();
  let lx=event.clientX-st.left+14, ly=event.clientY-st.top+14;
  const tw=tip.offsetWidth,th=tip.offsetHeight;
  if(lx+tw>st.width-8) lx=event.clientX-st.left-tw-14;
  if(ly+th>st.height-8) ly=event.clientY-st.top-th-14;
  tip.style.left=lx+"px"; tip.style.top=ly+"px";
}
function hideTip(){ tip.classList.remove("show"); }

/* zoom / fit */
const zoom=d3.zoom().scaleExtent([0.12,14])
  .on("start",()=>{svg.classed("dragging",true);zoomMoved=false;})
  .on("zoom",e=>{scene.attr("transform",e.transform);curK=e.transform.k;if(e.sourceEvent)zoomMoved=true;})
  .on("end",()=>svg.classed("dragging",false));
svg.call(zoom).on("dblclick.zoom",null);
function fitView(animate){
  const W=svg.node().clientWidth,H=svg.node().clientHeight;
  let x0=1/0,y0=1/0,x1=-1/0,y1=-1/0;
  MODEL.parents.forEach(p=>p.leaves.forEach(l=>l.pts.forEach(n=>{
    const ax=p.x+n.rx, ay=p.y+n.ry;
    x0=Math.min(x0,ax-n.r);y0=Math.min(y0,ay-n.r-18);x1=Math.max(x1,ax+n.r);y1=Math.max(y1,ay+n.r);})));
  const k=Math.min(W/(x1-x0),H/(y1-y0))*0.92;
  const t=d3.zoomIdentity.translate(W/2-k*(x0+x1)/2,H/2-k*(y0+y1)/2).scale(k);
  curK=k;
  (animate?svg.transition().duration(500):svg).call(zoom.transform,t);
}

/* controls */
document.getElementById("sizeToggle").addEventListener("change",e=>{sizeBy=e.target.checked;layout();render(true);fitView(true);});
document.getElementById("colorToggle").addEventListener("change",e=>{colorFunding=e.target.checked;recolor();});
document.getElementById("reset").addEventListener("click",()=>fitView(true));
svg.on("click",e=>{if(!zoomMoved&&e.target.tagName!=="circle"&&(pinP!=null||pinL!=null)){pinP=null;pinL=null;applyFocus();}});

/* tree list */
function buildTree(){
  const tree=document.getElementById("tree"); tree.innerHTML="";
  [...HIER.parents].sort((a,b)=>b.size-a.size).forEach(p=>{
    const prow=document.createElement("button");
    prow.className="prow"; prow.dataset.p=p.id;
    prow.innerHTML=`<span class="caret">&#9654;</span><span class="sw" style="background:${pColor(p.id)}"></span>`+
      `<span class="pname">${esc(p.name)}</span><span class="pn">${p.size}</span>`;
    const kids=document.createElement("div"); kids.className="kids";
    HIER.leaves.filter(l=>l.parent===p.id).forEach(l=>{
      const lrow=document.createElement("button");
      lrow.className="lrow"; lrow.dataset.l=l.id;
      lrow.innerHTML=`<span class="sw-s" style="background:${leafColor[l.id]}"></span>`+
        `<span class="lname">${esc(l.name)}</span><span class="pn">${l.size}</span>`;
      lrow.addEventListener("mouseenter",()=>{if(pinP==null&&pinL==null){hoverL=l.id;applyFocus();}});
      lrow.addEventListener("mouseleave",()=>{if(pinP==null&&pinL==null){hoverL=null;applyFocus();}});
      lrow.addEventListener("click",ev=>{ev.stopPropagation();pinL=(pinL===l.id)?null:l.id;pinP=null;hoverL=null;applyFocus();});
      kids.appendChild(lrow);
    });
    prow.addEventListener("mouseenter",()=>{if(pinP==null&&pinL==null){hoverP=p.id;applyFocus();}});
    prow.addEventListener("mouseleave",()=>{if(pinP==null&&pinL==null){hoverP=null;applyFocus();}});
    prow.addEventListener("click",()=>{prow.classList.toggle("open");kids.classList.toggle("open");
      pinP=(pinP===p.id&&pinL==null)?null:p.id;pinL=null;hoverP=null;applyFocus();});
    tree.appendChild(prow); tree.appendChild(kids);
  });
}

/* boot */
document.getElementById("count").textContent=DATA.length.toLocaleString();
document.getElementById("pcount").textContent=HIER.parents.length;
document.getElementById("lcount").textContent=HIER.leaves.length;
document.getElementById("projnote").textContent=
  (DATA[0]&&DATA[0].projection==="specter2-umap")?"SPECTER2 + UMAP":"t-SNE preview";
buildTree(); layout(); render(false); fitView(false);
window.addEventListener("resize",()=>fitView(false));
</script>
</body>
</html>
