<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grant Topic Hierarchy</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
  :root{
    --bg:#ffffff; --ink:#16181d; --muted:#5b616e; --hair:#e6e8ec; --panel:#ffffff;
    --accent:#4E79A7; --shadow:0 1px 2px rgba(20,24,29,.06),0 8px 24px rgba(20,24,29,.06);
    --mono:ui-monospace,"SF Mono",Menlo,"Cascadia Mono",Consolas,monospace;
    --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
    -webkit-font-smoothing:antialiased;overflow:hidden}
  #app{position:fixed;inset:0;display:flex;flex-direction:column}
  header{padding:16px 22px 12px;border-bottom:1px solid var(--hair);
    display:flex;align-items:baseline;gap:16px;flex-wrap:wrap}
  header h1{margin:0;font-size:18px;font-weight:650;letter-spacing:-.01em}
  header .sub{font-family:var(--mono);font-size:11.5px;color:var(--muted)}
  header .sub b{color:var(--ink);font-weight:600}

  #stage{position:relative;flex:1;min-height:0}
  svg{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab;touch-action:none}
  svg.dragging{cursor:grabbing}
  .phull{fill-opacity:.05;stroke-width:2.4;stroke-linejoin:round;transition:opacity .18s}
  .lhull{fill:none;stroke-width:1.1;stroke-dasharray:2 3;stroke-linejoin:round;transition:opacity .18s}
  circle.node{stroke:rgba(255,255,255,.85);stroke-width:.5;transition:opacity .18s}
  circle.node:hover{stroke:#16181d;stroke-width:1.3}
  .parent{cursor:grab}
  .parent.grabbing{cursor:grabbing}
  text.plabel{font-family:var(--sans);font-weight:700;font-size:13px;paint-order:stroke;
    stroke:#fff;stroke-width:4px;stroke-linejoin:round;pointer-events:none;transition:opacity .18s}
  text.llabel{font-family:var(--sans);font-weight:600;font-size:10px;paint-order:stroke;
    stroke:#fff;stroke-width:2.8px;stroke-linejoin:round;pointer-events:none;transition:opacity .18s}
  .parent.faded{opacity:.1}
  .leaf.faded{opacity:.16}

  .dock{position:absolute;top:14px;left:14px;z-index:5;display:flex;flex-direction:column;gap:10px;
    width:250px;max-width:calc(100vw - 28px);max-height:calc(100vh - 28px);overflow-y:auto}
  .card{background:var(--panel);border:1px solid var(--hair);border-radius:12px;
    box-shadow:var(--shadow);padding:12px 13px}
  .card h2{margin:0 0 9px;font-family:var(--mono);font-size:10.5px;font-weight:600;
    letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .toggle{display:flex;align-items:center;gap:10px;cursor:pointer;user-select:none;margin:2px 0}
  .toggle input{position:absolute;opacity:0;pointer-events:none}
  .track{width:38px;height:22px;border-radius:11px;background:#d3d6db;flex:none;position:relative;transition:background .16s}
  .track::after{content:"";position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;
    background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.25);transition:transform .16s}
  .toggle input:checked + .track{background:var(--accent)}
  .toggle input:checked + .track::after{transform:translateX(16px)}
  .toggle .lbl{font-size:12.5px}
  .btn{width:100%;border:1px solid var(--hair);background:#fff;border-radius:8px;padding:7px 8px;
    font-family:var(--mono);font-size:11px;color:var(--ink);cursor:pointer;margin-top:8px}
  .btn:hover{background:#f4f5f7}

  .tree{max-height:calc(100vh - 230px);overflow-y:auto;margin:0 -4px;padding:0 2px}
  .prow{position:relative;display:flex;align-items:center;gap:7px;width:100%;border:0;background:none;
    cursor:pointer;text-align:left;padding:6px 6px;border-radius:7px;color:var(--ink)}
  .prow:hover{background:#f0f4f8}
  .prow.pinned{background:#e9f1f8;box-shadow:inset 2px 0 0 var(--accent)}
  .caret{width:14px;flex:none;color:var(--muted);font-size:9px;text-align:center;transition:transform .15s}
  .prow.open .caret{transform:rotate(90deg)}
  .sw{width:12px;height:12px;border-radius:3px;flex:none}
  .pname{flex:1;font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pn{font-family:var(--mono);font-size:10px;color:var(--muted)}
  .kids{display:none;margin:2px 0 4px 0}
  .kids.open{display:block}
  .lrow{position:relative;display:flex;align-items:center;gap:7px;width:100%;border:0;background:none;
    cursor:pointer;text-align:left;padding:4px 6px 4px 22px;border-radius:6px;color:var(--ink)}
  .lrow:hover{background:#f0f4f8}
  .lrow.pinned{background:#e9f1f8;box-shadow:inset 2px 0 0 var(--accent)}
  .sw-s{width:9px;height:9px;border-radius:2px;flex:none}
  .lname{flex:1;font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hint{margin-top:9px;font-family:var(--mono);font-size:10.5px;color:var(--muted)}

  #tip{position:absolute;z-index:8;pointer-events:none;max-width:300px;background:#fff;
    border:1px solid var(--hair);border-radius:10px;box-shadow:var(--shadow);padding:10px 12px;
    font-size:12.5px;line-height:1.4;opacity:0;transform:translateY(3px);transition:opacity .1s,transform .1s}
  #tip.show{opacity:1;transform:none}
  #tip .t{font-weight:600;margin-bottom:5px}
  #tip .meta{font-family:var(--mono);font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  #tip .dot{width:8px;height:8px;border-radius:2px;display:inline-block}
  #tip .amt{color:var(--ink);font-weight:600}
  #tip .path{margin-top:5px;font-family:var(--mono);font-size:10.5px;color:var(--muted)}
  .credit{position:absolute;bottom:12px;right:14px;z-index:5;font-family:var(--mono);
    font-size:10px;color:#b3b7bf;text-align:right;line-height:1.5}
  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>Grant Topic Hierarchy</h1>
    <div class="sub"><b id="count">0</b> grants · <b id="pcount">0</b> parent topics ·
      <b id="lcount">0</b> leaves · <span id="projnote">projection</span></div>
  </header>
  <div id="stage">
    <svg id="svg"></svg>
    <div class="dock">
      <div class="card">
        <h2>Layout</h2>
        <label class="toggle"><input type="checkbox" id="sizeToggle"><span class="track"></span>
          <span class="lbl">Size by amount</span></label>
        <label class="toggle"><input type="checkbox" id="colorToggle"><span class="track"></span>
          <span class="lbl">Color by funding</span></label>
        <button class="btn" id="reset">Reset view</button>
      </div>
      <div class="card">
        <h2>Topic tree</h2>
        <div class="tree" id="tree"></div>
        <div class="hint">Hover to highlight · click to pin · &#9654; to expand</div>
      </div>
    </div>
    <div id="tip"></div>
    <div class="credit">t-SNE preview placement · re-run pipeline.py then inject.py<br>for SPECTER2 + UMAP output</div>
  </div>
</div>

<script>
